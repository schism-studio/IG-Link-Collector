{
  "manifest_version": 3,
  "name": "IG Saved Link Collector",
  "version": "1.4.0",
  "description": "Lightweight saved-link collector with TXT/CSV export, Clear and optional auto-scroll.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ig-saved-collector@local.test"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
